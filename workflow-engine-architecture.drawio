                </mxCell>
                <mxCell id="3 _s2" value="&lt;b&gt;2 · Scheduler: what is ready?&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;a task whose dependencies are all SUCCESS&lt;br&gt;becomes QUEUED (confirm_order first)&lt;br&gt;R6.4, R6.7&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a8a;" parent="1" vertex="1">
                    <mxGeometry x="350" y="170" width="270" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="3 _s3" value="&lt;b&gt;3 · Worker runs the task&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;find the function (registry), run it&lt;br&gt;TaskRun → RUNNING&lt;br&gt;R6.5, R6.6&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a8a;" parent="1" vertex="1">
                    <mxGeometry x="670" y="170" width="260" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="3 _dq" value="&lt;b&gt;Did it work?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#ffffff;strokeColor=#444b5a;fontColor=#1b1f2a;" parent="1" vertex="1">
                    <mxGeometry x="985" y="165" width="170" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="3 _s4" value="&lt;b&gt;4a · SUCCESS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;TaskRun → SUCCESS&lt;br&gt;scheduler asks again: next task ready?&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a8a;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="120" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="3 _s5" value="&lt;b&gt;4b · FAILED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;attempts left? → RETRYING (wait)&lt;br&gt;no attempts left → DEAD&lt;br&gt;Phase 4&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#eceff4;strokeColor=#8a94a6;fontColor=#394150;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="280" width="240" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="3 _s6" value="&lt;b&gt;5 · Run final status&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;all TaskRuns SUCCESS → Run SUCCESS&lt;br&gt;any task DEAD → Run FAILED&lt;br&gt;R6.8&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a8a;" parent="1" vertex="1">
                    <mxGeometry x="1230" y="440" width="240" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="3 _s7" value="&lt;b&gt;6 · First full run 🎉&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;R6.9: the whole workflow runs end to end,&lt;br&gt;the Run shows SUCCESS in the database&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#dbeafe;strokeColor=#3b82f6;fontColor=#1e3a8a;" parent="1" vertex="1">
                    <mxGeometry x="830" y="440" width="350" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="3 _tbl" value="&lt;b&gt;What the database looks like at each moment&lt;/b&gt; (Run #2 and its three TaskRuns)&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;margin-top:6px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#1b1f2a;color:#ffffff;font-size:11px;&quot;&gt;Moment&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#1b1f2a;color:#ffffff;font-size:11px;&quot;&gt;Run #2&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#1b1f2a;color:#ffffff;font-size:11px;&quot;&gt;confirm_order&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#1b1f2a;color:#ffffff;font-size:11px;&quot;&gt;make_invoice&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#1b1f2a;color:#ffffff;font-size:11px;&quot;&gt;send_message&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#ffffff;color:#1b1f2a;font-size:11px;&quot;&gt;Run #2 created&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#eceff4;color:#1b1f2a;font-size:11px;&quot;&gt;PENDING&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#eceff4;color:#1b1f2a;font-size:11px;&quot;&gt;PENDING&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#eceff4;color:#1b1f2a;font-size:11px;&quot;&gt;PENDING&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#eceff4;color:#1b1f2a;font-size:11px;&quot;&gt;PENDING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#ffffff;color:#1b1f2a;font-size:11px;&quot;&gt;confirm_order starts&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#fff1c2;color:#1b1f2a;font-size:11px;&quot;&gt;RUNNING&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#fff1c2;color:#1b1f2a;font-size:11px;&quot;&gt;RUNNING&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#eceff4;color:#1b1f2a;font-size:11px;&quot;&gt;PENDING&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#eceff4;color:#1b1f2a;font-size:11px;&quot;&gt;PENDING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#ffffff;color:#1b1f2a;font-size:11px;&quot;&gt;confirm_order done&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#fff1c2;color:#1b1f2a;font-size:11px;&quot;&gt;RUNNING&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#d4f8dc;color:#1b1f2a;font-size:11px;&quot;&gt;SUCCESS&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#dbeafe;color:#1b1f2a;font-size:11px;&quot;&gt;QUEUED&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#eceff4;color:#1b1f2a;font-size:11px;&quot;&gt;PENDING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#ffffff;color:#1b1f2a;font-size:11px;&quot;&gt;make_invoice done&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#fff1c2;color:#1b1f2a;font-size:11px;&quot;&gt;RUNNING&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#d4f8dc;color:#1b1f2a;font-size:11px;&quot;&gt;SUCCESS&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#d4f8dc;color:#1b1f2a;font-size:11px;&quot;&gt;SUCCESS&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#dbeafe;color:#1b1f2a;font-size:11px;&quot;&gt;QUEUED&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#ffffff;color:#1b1f2a;font-size:11px;&quot;&gt;send_message fails once&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#fff1c2;color:#1b1f2a;font-size:11px;&quot;&gt;RUNNING&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#d4f8dc;color:#1b1f2a;font-size:11px;&quot;&gt;SUCCESS&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#d4f8dc;color:#1b1f2a;font-size:11px;&quot;&gt;SUCCESS&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#ffe4e1;color:#1b1f2a;font-size:11px;&quot;&gt;RETRYING (try 1 of 3)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#ffffff;color:#1b1f2a;font-size:11px;&quot;&gt;send_message works&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#d4f8dc;color:#1b1f2a;font-size:11px;&quot;&gt;SUCCESS&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#d4f8dc;color:#1b1f2a;font-size:11px;&quot;&gt;SUCCESS&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#d4f8dc;color:#1b1f2a;font-size:11px;&quot;&gt;SUCCESS&lt;/td&gt;&lt;td style=&quot;border:1px solid #8a94a6;padding:4px 10px;background:#d4f8dc;color:#1b1f2a;font-size:11px;&quot;&gt;SUCCESS&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=4;align=left;verticalAlign=top;spacing=8;html=1;whiteSpace=wrap;strokeWidth=2;fontSize=12;fillColor=#ffffff;strokeColor=#444b5a;fontColor=#1b1f2a;" parent="1" vertex="1">
                    <mxGeometry x="40" y="610" width="1000" height="270" as="geometry"/>
                </mxCell>
                <mxCell id="3 _title" value="&lt;b&gt;Run logic — what happens when one order arrives (Sita's order)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=20;fontColor=#1b1f2a;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="14" width="1200" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="3 _sub" value="Workflow = recipe (confirm → invoice → message). Run = cooking it once. TaskRun = each step of that cooking." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#566074;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="44" width="1300" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="3 _note" value="&lt;b&gt;How the tickets connect&lt;/b&gt;&lt;br&gt;&lt;br&gt;R6.1–R6.2 build the tables that remember everything.&lt;br&gt;R6.3 fills them when a Run starts.&lt;br&gt;R6.4 + R6.7 decide what runs next.&lt;br&gt;R6.5 + R6.6 actually run it.&lt;br&gt;R6.8 closes the Run.&lt;br&gt;R6.9 proves it all works together.&lt;br&gt;&lt;br&gt;Phase 4 adds retry, timeout, heartbeat and idempotency to the red 'FAILED' path." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#394150;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="1080" y="620" width="420" height="240" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>