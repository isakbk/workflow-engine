                <mxCell id="1 _sub" value="R-numbers are your task tickets (R6.3 = ticket R6.3). Colour = status. Updated: Oct 2026" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#566074;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="40" y="44" width="1000" height="20" as="geometry"/>
                </mxCell>
                <mxCell id="1 _lgt" value="Read top to bottom: a request enters the API → is checked by the gatekeepers → is saved in the database → the engine core schedules and runs the tasks → the infrastructure (Redis, Celery, Docker) lets it scale. Dashed lines = built in a later phase." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#394150;strokeColor=none;fillColor=none;" parent="1" vertex="1">
                    <mxGeometry x="760" y="482" width="680" height="80" as="geometry"/>
                </mxCell>
